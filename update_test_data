#! /bin/bash
# Update the segmentation conformance test data from Unicode.
#
# Unicode 18.0.0 is released, so /Public/UCD/latest/ serves it. Track a future
# draft by pointing BASE at /Public/draft/ucd/auxiliary instead.
#
# The ICU corpus in test/support/test_data/icu_rbbitst.txt is vendored from
# ICU rather than Unicode and is not refreshed here.
set -euo pipefail

BASE=https://www.unicode.org/Public/UCD/latest/ucd/auxiliary
DEST=./test/support/test_data

fetch() {
  echo "  $1 -> $2"
  curl -fsS "$BASE/$1" -o "$DEST/$2"
}

fetch GraphemeBreakTest.txt grapheme_break_test.txt
fetch WordBreakTest.txt word_break_test.txt
fetch SentenceBreakTest.txt sentence_break_test.txt
fetch LineBreakTest.txt line_break_test.txt

echo
echo "Version headers now in $DEST:"
head -1 "$DEST"/*_break_test.txt | grep -E "^#" | sed 's/^/  /'
